# AudioGuard Backend Environment Configuration
# Use during development: `source .env.local && python app.py`
# Render will use environment variables from dashboard

# ── Server Configuration ─────────────────────────────────────────────────────
export PORT=5000
export HOST=0.0.0.0
export LOG_LEVEL=debug

# ── Audio Processing ────────────────────────────────────────────────────────
export AUDIOGUARD_STORAGE_DIR=/tmp/audioguard_storage
export MAX_UPLOAD_SIZE_MB=100
export MAX_AUDIO_DURATION_MINUTES=60
export FILE_TTL_HOURS=24

# ── API Configuration ───────────────────────────────────────────────────────
export API_TIMEOUT=300
export RATE_LIMIT_REQUESTS=100
export RATE_LIMIT_WINDOW=60

# ── Python Settings ────────────────────────────────────────────────────────
export PYTHONUNBUFFERED=1
export PYTHONDONTWRITEBYTECODE=1

# ── Security (Optional - Phase 2) ──────────────────────────────────────────
# export API_KEYS=dev-key-123,dev-key-456
# export CORS_ORIGINS=http://localhost:3000,https://audioguard.app

# ── Database (Optional - Phase 2) ──────────────────────────────────────────
# export DATABASE_URL=postgresql://user:pass@localhost/audioguard
# export REDIS_URL=redis://localhost:6379/0

# ── Feature Flags ──────────────────────────────────────────────────────────
export ENABLE_DECODE=false
export ENABLE_ANALYSE=true
export ENABLE_HEALTH_CHECKS=true

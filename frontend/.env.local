# AudioGuard Frontend Configuration for Development and Production
# Flutter app will read these constants at runtime

# Local Development
export FLUTTER_API_URL_DEV=http://localhost:5000
export FLUTTER_API_TIMEOUT_DEV=30

# Staging (Internal Testing)
export FLUTTER_API_URL_STAGING=https://audioguard-staging.onrender.com
export FLUTTER_API_TIMEOUT_STAGING=30

# Production (Render Cloud)
export FLUTTER_API_URL_PROD=https://audioguard-api.onrender.com
export FLUTTER_API_TIMEOUT_PROD=30

# Firebase (Optional - Phase 2)
# export FIREBASE_PROJECT_ID=audioguard-prod
# export FIREBASE_API_KEY=AIzaSy...

# Feature Flags
export FEATURE_DECODE_ENABLED=false
export FEATURE_ANALYSE_ENABLED=true
export FEATURE_ADVANCED_SETTINGS=true

# UI Theme
export THEME_PRIMARY_COLOR=#6366F1
export THEME_SECONDARY_COLOR=#EC4899
export THEME_DARK_MODE_DEFAULT=false
